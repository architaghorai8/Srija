# GEMINI_API_KEY: Required for optional server-side Gemini AI calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SESSION_SECRET: HMAC signing secret for server-issued Bearer session tokens (auto-generated fallback in memory if omitted).
SESSION_SECRET=

# ADMIN_EMAIL / ADMIN_PASSCODE: Optional server-side administrator credentials for /secure-control-center.
# If left empty, the first administrator can claim access via the inline setup form at /secure-control-center.
ADMIN_EMAIL=
ADMIN_PASSCODE=

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: Optional external Supabase PostgreSQL + Storage connector.
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server (never prefix with VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=edna-datasets

# VITE_FIREBASE_* : Optional external Firebase Web SDK configuration placeholders.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# NCBI_API_KEY / EXTERNAL_BLAST_ENDPOINT: Optional external bioinformatics reference API configuration.
NCBI_API_KEY=
EXTERNAL_BLAST_ENDPOINT=
